{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "types": ["node", "chrome"],
    "paths": {
      "react": ["./apps/extension/node_modules/@types/react"],
      "react-dom/client": [
        "./apps/extension/node_modules/@types/react-dom/client"
      ]
    }
  },
  "include": [
    "scripts/check-cli.ts",
    "scripts/dev-extension.ts",
    "scripts/google-cloud-cli.ts",
    "scripts/package-review.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "vitest.config.ts",
    "development/**/*.ts",
    "scripts/build-core-1.ts"
  ]
}
