{
  "name": "otpguard",
  "version": "0.0.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.19.0 <23"
  },
  "scripts": {
    "fixtures": "bun scripts/serve-fixtures.ts",
    "dev:web": "bun run --filter @otpguard/web dev",
    "cli:check": "bun scripts/check-cli.ts",
    "cli:clerk": "CLERK_TELEMETRY_DISABLED=1 clerk",
    "build": "bun run --filter '@otpguard/*' build",
    "typecheck": "bun run --filter '@otpguard/*' typecheck && tsc -p tsconfig.tools.json",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .git/info/exclude",
    "test": "vitest run",
    "test:browser": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test",
    "package:review": "bun scripts/package-review.ts",
    "check:packages": "node scripts/check-review-packages.mjs"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "5.27.2",
    "@eslint/js": "10.0.1",
    "@next/eslint-plugin-next": "16.3.8",
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.1.37",
    "@types/node": "22.19.15",
    "clerk": "3.4.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "sharp"
  ]
}
