# Optional PR 7 account configuration. Leave unset for credential-free builds/CI.
# Web only: put real values in apps/web/.env.local (ignored), never in the extension.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Extension: put public values in apps/extension/.env.account (ignored).
# Explicitly load with: bun --env-file=.env.account run build (from apps/extension).
# Production key only: pk_test_ transport puts a browser JWT in API URLs and is unsupported.
PLASMO_PUBLIC_CLERK_PUBLISHABLE_KEY=
PLASMO_PUBLIC_CLERK_FRONTEND_API=
PLASMO_PUBLIC_CLERK_SYNC_HOST=
PLASMO_PUBLIC_ACCOUNT_WEB_ORIGIN=
# Frontend API and sync host must be the same exact HTTPS origin, with no port/path.
# Account web origin is a separate exact HTTPS origin. No loopback production exceptions.
# Do not add Gmail tokens, Clerk secret keys, passwords, or sessions to extension config.

# Optional PR 8 public Google configuration; all three values required together.
# Keep unset until an authorized Chrome extension OAuth client is registered.
PLASMO_PUBLIC_GOOGLE_CLIENT_ID=
# Base64 DER SubjectPublicKeyInfo public key; never a private key.
PLASMO_PUBLIC_EXTENSION_KEY=
# 32-character a-p Chrome extension ID derived from that key and registered with Google.
PLASMO_PUBLIC_EXTENSION_ID=

# PR11 backend-only Clerk issuer for a future separately authorized Convex deployment.
# Leave unset: no JWT providers/cloud transport are configured in the local prototype.
# This does not activate sync. Never put Clerk sessions or Gmail credentials here.
CLERK_JWT_ISSUER_DOMAIN=
